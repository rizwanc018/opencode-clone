{
    "name": "@opencode-clone/server",
    "type": "module",
    "private": true,
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target bun",
        "postinstall": "bun run --cwd ../database db:generate"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.79",
        "@ai-sdk/google": "^3.0.79",
        "@ai-sdk/openai": "^3.0.65",
        "@hono/zod-validator": "^0.8.0",
        "@opencode-clone/database": "workspace:*",
        "@opencode-clone/shared": "workspace:*",
        "ai": "^6.0.191",
        "hono": "^4.12.22",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14"
    }
}
